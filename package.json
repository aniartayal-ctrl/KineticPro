{
  "name": "kinetic",
  "version": "1.0.0",
  "private": true,
  "description": "Kinetic Pro — Native macOS Apple Metal 2D Mesh, Rigging, Weight-Painting & AI Animation Studio for Unity",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3460",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3460",
    "build": "next build",
    "build:mac": "zsh scripts/build-mac.sh",
    "start": "next start --hostname 127.0.0.1 --port 3460",
    "test": "tsx --test src/core/*.test.ts src/core/copilot/*.test.ts src/copilot/*.test.ts src/exporters/*.test.ts src/server/*.test.ts",
    "test:vision": "vision/.venv/bin/python3 vision/test_amodal_cutter.py",
    "export:cli": "tsx src/cli/export.ts",
    "migrate:slotspy": "tsx src/cli/migrate-slotspy.ts",
    "verify:unity": "tsx src/cli/verify-unity.ts",
    "verify:all": "npm test && tsx src/cli/verify-unity.ts",
    "test:ui": "node scripts/smoke-ui.mjs",
    "eval:copilot": "tsx scripts/eval-copilot.ts",
    "mock:anthropic": "node scripts/mock-anthropic.mjs",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "delaunator": "^5.0.1",
    "earcut": "^3.0.1",
    "gsap": "^3.15.0",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "maxrects-packer": "^2.7.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@esotericsoftware/spine-core": "^4.2.120",
    "@tailwindcss/postcss": "^4",
    "@types/delaunator": "^5.0.0",
    "@types/earcut": "^2.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.50.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
